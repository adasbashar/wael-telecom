<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build with:  dotnet build -c Release -p:Store=wael   (or -p:Store=sham) -->
  <PropertyGroup>
    <Store Condition="'$(Store)' == ''">wael</Store>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ApplicationIcon>icons\$(Store).ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);STORE_$(Store.ToUpper())</DefineConstants>
    <Version>1.3.0</Version>
    <Company>$(Store)</Company>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Store)' == 'wael'">
    <AssemblyName>WaelTelecom</AssemblyName>
    <Product>Wael Telecom</Product>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Store)' == 'sham'">
    <AssemblyName>ShamTelecom</AssemblyName>
    <Product>Sham Telecom</Product>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
</Project>
